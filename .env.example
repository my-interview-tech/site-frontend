# Локальная разработка (APP_ENV=localhost → .env.localhost)

# true — экраны статьи и технологии на моках, без backend; false — экраны статьи и технологии на живом API
VITE_API_MOCK=false

VITE_API_URL=http://localhost:8080
VITE_COOKIE_DOMAIN=localhost

VITE_MAIN_APP_URL=http://localhost:3001
MAIN_APP_PORT=3001

VITE_SITE_URL=http://localhost:3000
SITE_PORT=3000

# Пусто — Метрика не грузится. Число — id счётчика
VITE_YM_COUNTER_ID=

# .env/.base/.env
# Test-стенд (APP_ENV=test → .env.test)

# VITE_SITE_URL=https://test.my-interview.tech
# VITE_MAIN_APP_URL=https://online-test.my-interview.tech
# VITE_API_URL=https://api-test.my-interview.tech
# VITE_COOKIE_DOMAIN=.my-interview.tech
# VITE_YM_COUNTER_ID=

