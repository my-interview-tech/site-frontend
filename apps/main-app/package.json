{
  "name": "@my-interview/main-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development APP_ENV=localhost vite",
    "build": "cross-env NODE_ENV=production APP_ENV=production vite build",
    "build:test": "cross-env NODE_ENV=production APP_ENV=test vite build",
    "preview": "vite preview",
    "lint": "cd ../.. && eslint -c .eslintrc.cjs --ext .ts,.tsx apps/main-app/src",
    "lint:styled": "stylelint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@generouted/react-router": "^1.20.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.6.2",
    "styled-components": "^6.1.11"
  }
}
