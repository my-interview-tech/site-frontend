{
  "name": "@my-interview/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development APP_ENV=localhost vite",
    "build:test": "cross-env NODE_ENV=production APP_ENV=test vite build",
    "build": "cross-env NODE_ENV=production APP_ENV=production vite build",
    "preview": "vite preview",
    "lint": "cd ../.. && eslint -c .eslintrc.cjs --ext .ts,.tsx apps/site/src",
    "lint:styled": "stylelint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@generouted/react-router": "^1.20.2",
    "@my-interview/common": "1.0.0",
    "@my-interview/feature-article": "1.0.0",
    "@my-interview/feature-articles-list": "1.0.0",
    "@my-interview/feature-quiz": "1.0.0",
    "@my-interview/feature-roadmap": "1.0.0",
    "@my-interview/feature-task": "1.0.0",
    "@my-interview/feature-tasks-list": "1.0.0",
    "@my-interview/static": "1.0.0",
    "@my-interview/ui-kit": "1.0.0",
    "lottie-web": "5.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.6.2",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "dotenv-flow": "^4.1.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4"
  }
}
