{
  "name": "@my-interview/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "vite": "8.1.4"
  },
  "scripts": {
    "dev": "concurrently \"yarn dev:site\" \"yarn dev:main-app\"",
    "dev:site": "yarn workspace @my-interview/site dev",
    "dev:main-app": "yarn workspace @my-interview/main-app dev",
    "clean:vite": "rm -rf apps/site/node_modules/.vite apps/main-app/node_modules/.vite",
    "build": "yarn workspace @my-interview/site build && yarn workspace @my-interview/main-app build",
    "build:test": "yarn workspace @my-interview/site build:test && yarn workspace @my-interview/main-app build:test",
    "build:site:test": "yarn workspace @my-interview/site build:test",
    "build:main-app:test": "yarn workspace @my-interview/main-app build:test",
    "analyze": "cross-env ANALYZE=true yarn workspace @my-interview/site build",
    "preview": "yarn workspace @my-interview/site preview",
    "lint": "yarn tslint && yarn tsc && yarn lint:styled",
    "tslint": "eslint -c .eslintrc.cjs --ext .ts,.tsx apps packages",
    "tslint:fix": "eslint --fix -c .eslintrc.cjs --ext .ts,.tsx apps packages",
    "lint:styled": "stylelint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "tsc": "tsc --noEmit",
    "prettier": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "test": "yarn workspace @my-interview/site test && yarn workspace @my-interview/main-app test",
    "test:watch": "yarn workspace @my-interview/site test:watch",
    "test:coverage": "yarn workspace @my-interview/site test --coverage",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@feature-sliced/eslint-plugin-messages": "0.1.0-beta.2",
    "@generouted/react-router": "^1.20.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-boundaries": "^4.2.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "postcss-styled-syntax": "^0.6.4",
    "prettier": "3.0.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
