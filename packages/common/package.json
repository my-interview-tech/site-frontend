{
  "name": "@my-interview/common",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.lib.ts",
    "storybook": "storybook dev -p 6007 --no-open",
    "storybook:build": "storybook build",
    "lint": "cd ../.. && eslint -c .eslintrc.cjs --ext .ts,.tsx packages/common/src packages/common/.storybook",
    "lint:styled": "stylelint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && yarn typecheck:storybook",
    "typecheck:storybook": "tsc -p .storybook/tsconfig.json --noEmit",
    "test": "vitest run --config ../../vite.package.ts --passWithNoTests"
  },
  "dependencies": {
    "@codemirror/language": "^6.6.0",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/common": "^1.5.5",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.0",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "storybook": "10.6.3",
    "@my-interview/ui-kit": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.0.0",
    "@my-interview/ui-kit": "^1.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.my-interview.tech/"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "sideEffects": false
}
