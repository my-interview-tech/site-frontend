{
  "name": "@my-interview/ui-kit",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "source": "./src/theme/theme.ts",
      "types": "./dist/theme/theme.d.ts",
      "import": "./dist/theme/theme.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.lib.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "lint": "cd ../.. && eslint -c .eslintrc.cjs --ext .ts,.tsx packages/ui-kit/src packages/ui-kit/.storybook",
    "lint:styled": "stylelint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && yarn typecheck:storybook",
    "typecheck:storybook": "tsc -p .storybook/tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "storybook": "10.6.3"
  },
  "dependencies": {
    "axios": "^1.21.0"
  },
  "publishConfig": {
    "registry": "https://npm.my-interview.tech/"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/theme/styled.js",
    "./src/theme/styled.ts"
  ]
}
