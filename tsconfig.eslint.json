{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@my-interview/auth": ["./packages/auth/src/index.ts"],
      "@my-interview/auth/*": ["./packages/auth/src/*"],
      "@my-interview/common": ["./packages/common/src/index.ts"],
      "@my-interview/common/*": ["./packages/common/src/*"],
      "@my-interview/feature-article": ["./packages/feature-article/src/index.ts"],
      "@my-interview/feature-article/*": ["./packages/feature-article/src/*"],
      "@my-interview/feature-articles-list": ["./packages/feature-articles-list/src/index.ts"],
      "@my-interview/feature-articles-list/*": ["./packages/feature-articles-list/src/*"],
      "@my-interview/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@my-interview/ui-kit/*": ["./packages/ui-kit/src/*"]
    }
  },
  "include": [
    "apps/*/src",
    "apps/*/vite.config.ts",
    "packages/*/src",
    "vite.shared.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"]
}
