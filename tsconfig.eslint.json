{
  "extends": [
    "./tsconfig.base.json",
    "./tsconfig.paths.workspace.json"
  ],
  "compilerOptions": {
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "apps/*/src",
    "apps/*/vite.config.ts",
    "packages/*/src",
    "vite.shared.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}