{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NPM_TOKEN"],
  "globalDependencies": [
    ".nvmrc",
    "tsconfig.base.json",
    "tsconfig.eslint.json",
    "vite.shared.ts",
    "vite.package.ts",
    "vite.lib.ts",
    ".eslintrc.cjs",
    ".stylelintrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["APP_ENV", "NODE_ENV", "VITE_*"]
    },
    "typecheck": {},
    "lint": {},
    "lint:styled": {},
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
